generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Product {
  id                          String               @id @default(cuid())
  sourcePlatform              String?
  sourceProductId             String?              @unique
  contentId                   String?
  sourceStatus                String?
  titleSource                 String
  titleEdited                 String?
  descriptionSource           String?
  descriptionEdited           String?
  salePriceSource             Float?
  salePriceEdited             Float?
  stock                       Int                  @default(0)
  currency                    String               @default("TRY")
  listPriceSource             Float?
  deliveryDurationSource      Int?
  deliveryDurationEdited      Int?
  vatRateSource               Float?
  vatRateEdited               Float?
  brand                       String?
  brandId                     Int?
  sku                         String?
  barcode                     String?
  categorySource              String?
  categoryName                String?
  categoryId                  Int?
  localCategoryId             String?
  attributesJson              Json?
  productMainId               String?
  cargoCompanyId              Int?
  shipmentAddressId           Int?
  returningAddressId          Int?
  suggestedBrandId            Int?
  suggestedBrandConfidence    Float?
  suggestedCategoryId         Int?
  suggestedCategoryConfidence Float?
  status                      String               @default("draft")
  images                      ProductImage[]
  marketplaceProducts         MarketplaceProduct[]
  exportJobItems              ExportJobItem[]
  activities                  ProductActivity[]
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt
}

model ProductActivity {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type         String
  message      String
  metadataJson Json?
  createdAt    DateTime @default(now())

  @@index([productId, createdAt])
  @@index([type, createdAt])
}

model DuplicateExclusion {
  id        String   @id @default(cuid())
  pairKey   String   @unique
  createdAt DateTime @default(now())
}

model ProductImage {
  id             String   @id @default(cuid())
  productId      String
  sourceUrl      String
  localPath      String?
  downloadStatus String?  @default("remote")
  sortOrder      Int      @default(0)
  isSelected     Boolean  @default(true)
  createdAt      DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

enum Marketplace {
  trendyol
  shopify
  n11
  hepsiburada
  pttavm
  amazon
}

enum ExportJobStatus {
  pending
  running
  completed
  failed
}

enum ExportJobItemStatus {
  pending
  running
  completed
  failed
  skipped
}

enum MarketplaceProductStatus {
  linked
  exported
  failed
  archived
}

model MarketplaceAccount {
  id                  String               @id @default(cuid())
  marketplace         Marketplace
  name                String
  credentialsJson     Json
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  marketplaceProducts MarketplaceProduct[]
  exportJobs          ExportJob[]

  @@unique([marketplace, name])
}

model MarketplaceProduct {
  id                   String                   @id @default(cuid())
  productId            String
  product              Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  marketplace          Marketplace
  marketplaceAccountId String?
  marketplaceAccount   MarketplaceAccount?      @relation(fields: [marketplaceAccountId], references: [id], onDelete: SetNull)
  externalProductId    String?
  externalSku          String?
  status               MarketplaceProductStatus @default(linked)
  lastExportedAt       DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@index([productId, marketplace, marketplaceAccountId])
  @@index([marketplace, status])
}

model ExportJob {
  id                   String              @id @default(cuid())
  targetMarketplace    Marketplace
  marketplaceAccountId String?
  marketplaceAccount   MarketplaceAccount? @relation(fields: [marketplaceAccountId], references: [id], onDelete: SetNull)
  status               ExportJobStatus     @default(pending)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  items                ExportJobItem[]

  @@index([targetMarketplace, status])
}

model ExportJobItem {
  id               String              @id @default(cuid())
  exportJobId      String
  exportJob        ExportJob           @relation(fields: [exportJobId], references: [id], onDelete: Cascade)
  productId        String
  product          Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  status           ExportJobItemStatus @default(pending)
  targetExternalId String?
  requestPayload   Json?
  responsePayload  Json?
  errorMessage     String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([exportJobId, status])
  @@index([productId])
}

model CategoryMapping {
  id                     String      @id @default(cuid())
  localCategoryId        String?
  localCategoryName      String?
  marketplace            Marketplace
  targetCategoryId       String
  targetCategoryName     String?
  requiredAttributesJson Json?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  @@index([marketplace, localCategoryId])
}

model AttributeMapping {
  id                  String      @id @default(cuid())
  marketplace         Marketplace
  localAttributeName  String
  targetAttributeName String
  targetAttributeId   String?
  valueMappingJson    Json?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([marketplace, localAttributeName])
}

model MarketplaceCategoryCache {
  id          String      @id @default(cuid())
  marketplace Marketplace
  externalId  String
  name        String
  parentId    String?
  rawPayload  Json
  updatedAt   DateTime    @updatedAt

  @@unique([marketplace, externalId])
  @@index([marketplace, name])
}

model MarketplaceBrandCache {
  id          String      @id @default(cuid())
  marketplace Marketplace
  externalId  String
  name        String
  parentId    String?
  rawPayload  Json
  updatedAt   DateTime    @updatedAt

  @@unique([marketplace, externalId])
  @@index([marketplace, name])
}

model MarketplaceAttributeCache {
  id          String      @id @default(cuid())
  marketplace Marketplace
  externalId  String
  name        String
  parentId    String?
  rawPayload  Json
  updatedAt   DateTime    @updatedAt

  @@unique([marketplace, externalId, parentId])
  @@index([marketplace, parentId])
}

model ProductTemplate {
  id                      String      @id @default(cuid())
  name                    String
  marketplace             Marketplace
  categoryId              String?
  categoryName            String?
  defaultAttributes       Json?
  defaultVatRate          Float?
  defaultCargoCompanyId   Int?
  defaultDeliveryDuration Int?
  defaultBrandId          Int?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  @@unique([marketplace, name])
}
